# Copy to .env and fill in
GROQ_API_KEY=your-groq-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-70b-versatile

# logfire token (optional for local dev)
LOGFIRE_TOKEN=

# MongoDB (the MVP storage adapter)
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=budgetiq
MONGO_ENSURE_INDEXES=false

# Demo data is opt-in and is only inserted into a completely empty database.
BUDGETIQ_SEED_DEMO=false

# Used by the optional Supabase/Postgres migration, not by the MVP adapter.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/budgetiq

# Frontend (Vite + React at the repo root; VITE_* values are read from .env).
# VITE_API_URL defaults (when unset) to the Enter Cloud API gateway, so the
# deployed preview talks to the cloud backend. For local dev against the Python
# backend, set VITE_API_URL=/api (proxied to localhost:8000 by the Vite server).
VITE_API_URL=/api
VITE_AUTH_MODE=dev
VITE_DEV_AUTH_TOKEN=replace-with-dev-bearer-token
# Enter Cloud project credentials (publishable; used by the auth pages).
VITE_SUPABASE_URL=https://spb-t4n36368isizplpp.supabase.opentrust.net
VITE_SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJyb2xlIjoiYW5vbiIsInJlZiI6InNwYi10NG4zNjM2OGlzaXpwbHBwIiwiaXNzIjoic3VwYWJhc2UiLCJpYXQiOjE3ODk3NDk4MTYsImV4cCI6MjEwNTMyNTgxNn0.hVUn-iPHPUAbFRts-Or6V7zxmnoHMw9eZ8Yr4NZW8Ho
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication and tenant boundary.
# Development mode must be explicit and requires configured values.
BUDGETIQ_ENV=development
BUDGETIQ_AUTH_MODE=dev
BUDGETIQ_DEV_AUTH_TOKEN=replace-with-dev-bearer-token
BUDGETIQ_DEV_ORGANIZATION_ID=replace-with-dev-org-id
BUDGETIQ_DEV_USER_ID=local-developer
BUDGETIQ_DEV_ROLE=VP Finance
BUDGETIQ_DEV_DISPLAY_NAME=Local Developer

# Production JWT settings (required for production)
SUPABASE_JWT_SECRET=
AUTH_JWT_AUDIENCE=
AUTH_JWT_ISSUER=
CSRF_SECRET=

# Stripe billing is deferred for this milestone and disabled by default.
# Do not set Stripe values unless explicitly enabling billing work.
BUDGETIQ_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

