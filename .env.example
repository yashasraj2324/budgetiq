# Copy to .env and fill in
QWEN_API_KEY=your-qwen-key-here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# logfire token (optional for local dev)
LOGFIRE_TOKEN=

# MongoDB (the MVP storage adapter)
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=budgetiq
MONGO_ENSURE_INDEXES=false

# Demo data is opt-in and is only inserted into a completely empty database.
BUDGETIQ_SEED_DEMO=false

# Used by the optional Supabase/Postgres migration, not by the MVP adapter.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/budgetiq

# Frontend (copy to frontend/.env.local for a local Next.js run)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication and tenant boundary. Development still requires this bearer
# token; production must use Supabase-compatible JWT verification.
BUDGETIQ_ENV=development
BUDGETIQ_AUTH_MODE=dev
BUDGETIQ_DEV_AUTH_TOKEN=local-dev-token
BUDGETIQ_DEV_ORGANIZATION_ID=local-demo
BUDGETIQ_DEV_USER_ID=local-developer
BUDGETIQ_DEV_ROLE=VP Finance
# Production only:
# SUPABASE_JWT_SECRET=
# AUTH_JWT_AUDIENCE=

# Stripe billing (required only when billing is enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
